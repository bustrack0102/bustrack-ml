# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Datasets and large binary models (never commit raw dataset or heavy weights)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.pkl
*.joblib
*.h5
*.pt
*.onnx

# Environment variables & secrets
.env
.env.*
!.env.example

# IDEs
.vscode/
.idea/
*.swp
